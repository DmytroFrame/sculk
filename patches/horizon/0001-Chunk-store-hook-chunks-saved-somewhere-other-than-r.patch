+++ b/crates/horizon-hooks/src/storage.rs
@@ -0,0 +1,47 @@
+//! Where the game keeps saved chunks when a crate above the engine keeps them somewhere other than the world's
+//! region files: a database that several servers share, for one. The engine keeps everything else about saving
+//! (when it saves, the records' contents, upgrading old ones); a [`ChunkStore`] only holds the records.
+//!
+//! A record is what a region file holds for a chunk once decompressed: a named NBT root, as bytes. Folders are the
+//! region file folders of a dimension: `region` (terrain), `entities` and `poi`. A dimension is named by the folder
+//! the game saves it in (`world/`, `world/dimensions/minecraft/the_nether`...), which the store maps to its own keys.
+//!
+//! Without a registered store, the game uses region files, as vanilla does.
+
+use std::io;
+use std::path::Path;
+
+/// The chunk records of every dimension of a world.
+pub trait ChunkStore: Send + Sync {
+    /// The record of chunk `x, z` in `folder` of the dimension saved in `dimension_dir`, or `None` when the chunk
+    /// was never saved. Called on the game's threads, often: it should answer from memory when it can.
+    fn read(
+        &self,
+        dimension_dir: &Path,
+        folder: &str,
+        x: i32,
+        z: i32,
+    ) -> io::Result<Option<Vec<u8>>>;
+
+    /// Stores `records` in order; `None` deletes a chunk's record. Called on the game's region writer thread; once
+    /// it returns the records count as saved.
+    fn write(
+        &self,
+        dimension_dir: &Path,
+        folder: &str,
+        records: &[((i32, i32), Option<Vec<u8>>)],
+    ) -> io::Result<()>;
+
+    /// Which chunks of region `rx, rz` (32 by 32 chunks) have a record in `folder`, as bits `x + z * 32` of the
+    /// chunk within the region. The far view and the scan for chunks saved by older versions ask it. The default
+    /// says none, which only makes the far view draw generated terrain where saved terrain was.
+    fn saved_in_region(
+        &self,
+        _dimension_dir: &Path,
+        _folder: &str,
+        _rx: i32,
+        _rz: i32,
+    ) -> io::Result<[u64; 16]> {
+        Ok([0; 16])
+    }
+}
