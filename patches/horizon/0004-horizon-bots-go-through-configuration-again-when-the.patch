 1 file changed, 88 insertions(+), 13 deletions(-)

diff --git a/crates/horizon-bots/src/main.rs b/crates/horizon-bots/src/main.rs
index 944ee5ac80..2fb74982f7 100644
--- a/crates/horizon-bots/src/main.rs
+++ b/crates/horizon-bots/src/main.rs
@@ -390,6 +390,10 @@ struct Bot {
     target: Mutex<Vec<(u128, Option<i32>)>>,
     /// The last SetHealth.
     health: Mutex<Option<f32>>,
+    /// The server sent the bot back to configuration (a proxy moving it to another server): its moves wait.
