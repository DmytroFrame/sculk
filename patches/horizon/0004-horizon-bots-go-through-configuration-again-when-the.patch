+    reconfigured: AtomicU64,
 }
 
 impl Bot {
@@ -874,6 +878,58 @@ fn join(o: &Options, name: &str) -> Result<Connection, String> {
     }
 }
 
+/// Back in configuration during play: acknowledges it, answers the server's configuration as `join` does, and
+/// returns once the server finished it (the new join follows in play).
+fn reconfigure(
+    reader: &mut horizon_protocol::connection::ConnReader,
+    writer: &Mutex<ConnWriter>,
+) -> Result<(), String> {
+    use ids::configuration::clientbound as cb;
+    let send = |body: Vec<u8>| lock(writer).send(&body).map_err(err);
+    send(play::Serverbound::ConfigurationAcknowledged(Empty).encode())?;
+    loop {
+        let (id, body) = reader.recv().map_err(err)?;
+        let reply = match id {
+            cb::SELECT_KNOWN_PACKS
+            | cb::KEEP_ALIVE
+            | cb::PING
+            | cb::CODE_OF_CONDUCT
+            | cb::COOKIE_REQUEST
+            | cb::DISCONNECT
+            | cb::FINISH_CONFIGURATION => match configuration::Clientbound::decode(id, &body)
+                .map_err(err)?
+            {
+                configuration::Clientbound::SelectKnownPacks(p) => {
+                    configuration::Serverbound::SelectKnownPacks(p)
+                }
+                configuration::Clientbound::KeepAlive(p) => {
+                    configuration::Serverbound::KeepAlive(p)
+                }
+                configuration::Clientbound::Ping(p) => configuration::Serverbound::Pong(p),
+                configuration::Clientbound::CodeOfConduct(_) => {
+                    configuration::Serverbound::AcceptCodeOfConduct(Empty)
+                }
+                configuration::Clientbound::CookieRequest(p) => {
+                    configuration::Serverbound::CookieResponse(configuration::CookieResponse {
+                        key: p.key,
+                        payload: None,
+                    })
+                }
+                configuration::Clientbound::Disconnect(p) => {
+                    let reason = horizon_protocol::text::plain(&p.reason, &Default::default());
+                    return Err(format!("disconnected during configuration: {reason}"));
+                }
+                configuration::Clientbound::FinishConfiguration(_) => {
+                    return send(configuration::Serverbound::FinishConfiguration(Empty).encode());
+                }
+                _ => continue,
+            },
+            _ => continue,
+        };
+        send(reply.encode())?;
+    }
+}
+
 /// ChunkBatchSizeCalculator: the chunks per tick a vanilla client asks for, from how long its batches take
 /// to arrive.
 struct BatchSize {
@@ -1081,19 +1137,34 @@ fn read(
                 lock(&bot.entities).update(id, &body);
                 Ok(())
             }
-            cb::DISCONNECT | cb::START_CONFIGURATION => {
+            cb::START_CONFIGURATION => {
+                // A proxy moving the bot to another server (Velocity's server switch): configuration again, then a
+                // new join, as vanilla's ClientPacketListener.handleConfigurationStart.
+                bot.configuring.store(true, Ordering::SeqCst);
+                let configured = reconfigure(&mut reader, &writer);
+                lock(&bot.held).clear();
+                bot.configuring.store(false, Ordering::SeqCst);
+                match configured {
+                    Ok(()) => {
+                        bot.reconfigured.fetch_add(1, Ordering::Relaxed);
+                        Ok(())
+                    }
+                    Err(e) => {
+                        bot.online.store(false, Ordering::SeqCst);
+                        *lock(&bot.error) = Some(format!("configuration again: {e}"));
+                        return;
+                    }
+                }
+            }
+            cb::DISCONNECT => {
                 bot.online.store(false, Ordering::SeqCst);
-                *lock(&bot.error) = Some(if id == cb::DISCONNECT {
-                    format!(
-                        "disconnected: {}",
-                        String::from_utf8_lossy(&body)
-                            .chars()
-                            .filter(|c| !c.is_control())
-                            .collect::<String>()
-                    )
-                } else {
-                    "sent back to configuration".into()
-                });
+                *lock(&bot.error) = Some(format!(
+                    "disconnected: {}",
+                    String::from_utf8_lossy(&body)
+                        .chars()
+                        .filter(|c| !c.is_control())
+                        .collect::<String>()
+                ));
                 return;
             }
             _ => Ok(()),
@@ -1161,7 +1232,9 @@ fn run_bot(
         // Where the bots gather, for a client that comes to watch them (tools/perf_bench.py --server-bots).
         println!("{}", json!({ "spawn": spawn }));
     }
-    let send = |body: Vec<u8>| lock(&writer).send(&body).is_ok();
+    // Nothing of play goes out while the server has the bot in configuration.
+    let send =
+        |body: Vec<u8>| bot.configuring.load(Ordering::SeqCst) || lock(&writer).send(&body).is_ok();
     if !o.no_loaded {
         send(raw(sb::PLAYER_LOADED, |_| {}));
     }
@@ -1526,6 +1599,7 @@ fn main() {
         "chunks": bots.iter().map(|b| b.chunks.load(Ordering::Relaxed)).sum::<u64>(),
         "resent": bots.iter().map(|b| b.resent.load(Ordering::Relaxed)).sum::<u64>(),
         "pulled_back": bots.iter().map(|b| b.pulled_back.load(Ordering::Relaxed)).sum::<u64>(),
+        "reconfigured": bots.iter().map(|b| b.reconfigured.load(Ordering::Relaxed)).sum::<u64>(),
         "waited_ticks": bots.iter().map(|b| b.waited.load(Ordering::Relaxed)).sum::<u64>(),
         "attacks": bots.iter().map(|b| b.attacks.load(Ordering::Relaxed)).sum::<u64>(),
         "bytes_in": bots.iter().map(|b| b.bytes_in()).sum::<u64>(),
@@ -1547,6 +1621,7 @@ fn main() {
             "resent": b.resent.load(Ordering::Relaxed),
             "forgotten": b.forgotten.load(Ordering::Relaxed),
             "pulled_back": b.pulled_back.load(Ordering::Relaxed),
+            "reconfigured": b.reconfigured.load(Ordering::Relaxed),
             "waited_ticks": b.waited.load(Ordering::Relaxed),
             "error": *lock(&b.error),
             "attacks": b.attacks.load(Ordering::Relaxed),
