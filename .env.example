# Copy to .env and change what you need; compose.yaml and tools/docker.sh read it.
# Values with spaces go in quotes.

# The image tools/docker.sh builds and compose runs (SCULK_TAG is set by the script to the build it just made).
SCULK_IMAGE=sculk
# release (thin LTO, slow to build, what players should get) or fast (optimized, quick to link, for testing).
SCULK_PROFILE=release

# --- Required ---------------------------------------------------------------------------------------------------
# true: you accept Minecraft's EULA (https://aka.ms/MinecraftEULA) for the engines.
SCULK_EULA=false
# Horizon's prepared Minecraft 26.3 resources on this machine: horizon-prepare's output, or the Horizon launcher's
# versions/<version>/.local/horizon-client/26.3.
HORIZON_RESOURCES=./external/horizon/.local/horizon-client/26.3

# --- Players ----------------------------------------------------------------------------------------------------
# The port players connect to (TCP; UDP on it for Nether Tunnel).
SCULK_PORT=25565
SCULK_MOTD="A Minecraft Server"
SCULK_MAX_PLAYERS=10000
# true: players are checked with Mojang's session server and their connections encrypted (vanilla's online-mode).
SCULK_ONLINE_MODE=true
# server.properties (gamemode, difficulty, pvp...), server-icon.png, ops.json/whitelist.json/bans (seed the cluster's
# lists), datapacks/ and horizon-mods/: every engine gets them.
SCULK_CONFIG=./config

# --- World ------------------------------------------------------------------------------------------------------
SCULK_WORLD=world
# Every worker generates the same world from it.
SCULK_SEED=sculk
SCULK_VIEW_DISTANCE=10
# How chunk records are compressed: lz4 (fast), deflate (vanilla's default) or none. Vanilla reads all three.
SCULK_REGION_COMPRESSION=lz4
# Regions untouched for this many days are archived (0: never).
SCULK_ARCHIVE_AFTER_DAYS=30
# Archive cold regions to an S3 bucket (<endpoint>/<bucket>, e.g. https://s3.eu-central-1.amazonaws.com/my-worlds)
# instead of the AnvilDB volume.
SCULK_ARCHIVE_S3=
SCULK_S3_REGION=us-east-1
SCULK_S3_ACCESS_KEY=
SCULK_S3_SECRET_KEY=

# --- Cluster ----------------------------------------------------------------------------------------------------
# Engine workers: each runs the game for the players in its micro worlds. Players far apart play on different
# engines in parallel; they merge onto one engine when they meet. A worker that stops or dies hands its players over.
SCULK_WORKERS=2
# spread (players go to the least busy engine) or single (everyone on one engine; the others stand by).
SCULK_PLACEMENT=spread
# A micro world splits when its players' groups stay this many chunks apart for SCULK_SPLIT_AFTER_SECS, or at once
# when its engine takes longer than SCULK_SPLIT_OVERLOAD_MSPT milliseconds a tick.
SCULK_SPLIT_GAP=8
SCULK_SPLIT_AFTER_SECS=300
SCULK_SPLIT_OVERLOAD_MSPT=45
SCULK_LEASE_TTL_MS=10000

# --- Resources --------------------------------------------------------------------------------------------------
SCULK_ENGINE_MEMORY=6g
SCULK_IO_MEMORY=2g
SCULK_ANVILDB_MEMORY=2g
# The web console (http://127.0.0.1:<port> on this machine only).
SCULK_CONSOLE_PORT=7180

RUST_LOG=info
